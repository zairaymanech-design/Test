import os
import glob
import pandas as pd

# =========================================================
# CONFIGURATION
# =========================================================

# Folder containing CSV files
FOLDER_PATH = "./data"

# File patterns
GROUP_PATTERN = "output_group*.csv"
SERVICE_PATTERN = "output_service*.csv"

# File 1 (group file) columns
GROUP_UID_COLUMN = "UID_or_User"
GROUP_NAME_COLUMN = "Group"

# File 2 (service file) columns
SERVICE_UID_COLUMN = "uid"
SERVICE_GROUP_COLUMN = "group_name"

# Output Excel file
OUTPUT_FILE = "comparison_output.xlsx"

# =========================================================
# GET LATEST output_group FILE
# =========================================================

group_files = glob.glob(
    os.path.join(FOLDER_PATH, GROUP_PATTERN)
)

if not group_files:
    raise Exception("No output_group files found.")

latest_group_file = max(
    group_files,
    key=os.path.getmtime
)

# =========================================================
# GET LATEST output_service FILE
# =========================================================

service_files = glob.glob(
    os.path.join(FOLDER_PATH, SERVICE_PATTERN)
)

if not service_files:
    raise Exception("No output_service files found.")

latest_service_file = max(
    service_files,
    key=os.path.getmtime
)

print(f"Latest group file   : {latest_group_file}")
print(f"Latest service file : {latest_service_file}")

# =========================================================
# LOAD CSV FILES
# =========================================================

df_group = pd.read_csv(latest_group_file)
df_service = pd.read_csv(latest_service_file)

# =========================================================
# KEEP REQUIRED COLUMNS
# =========================================================

df_group = df_group[
    [GROUP_UID_COLUMN, GROUP_NAME_COLUMN]
].copy()

df_service = df_service[
    [SERVICE_UID_COLUMN, SERVICE_GROUP_COLUMN]
].copy()

# =========================================================
# RENAME TO COMMON FORMAT
# =========================================================

df_group.columns = ["uid", "group"]
df_service.columns = ["uid", "group"]

# =========================================================
# CLEAN DATA
# =========================================================

df_group["uid"] = (
    df_group["uid"]
    .astype(str)
    .str.strip()
)

df_group["group"] = (
    df_group["group"]
    .astype(str)
    .str.strip()
)

df_service["uid"] = (
    df_service["uid"]
    .astype(str)
    .str.strip()
)

df_service["group"] = (
    df_service["group"]
    .astype(str)
    .str.strip()
)

# =========================================================
# COMPARE FILES
# =========================================================

# Present in group file only
only_in_group = df_group.merge(
    df_service,
    on=["uid", "group"],
    how="left",
    indicator=True
)

only_in_group = only_in_group[
    only_in_group["_merge"] == "left_only"
]

# Present in service file only
only_in_service = df_service.merge(
    df_group,
    on=["uid", "group"],
    how="left",
    indicator=True
)

only_in_service = only_in_service[
    only_in_service["_merge"] == "left_only"
]

# =========================================================
# EXPORT RESULTS
# =========================================================

with pd.ExcelWriter(
    OUTPUT_FILE,
    engine="openpyxl"
) as writer:

    only_in_group.to_excel(
        writer,
        sheet_name="Only_In_Group",
        index=False
    )

    only_in_service.to_excel(
        writer,
        sheet_name="Only_In_Service",
        index=False
    )

print("\nComparison completed.")
print(f"Output saved to: {OUTPUT_FILE}")
