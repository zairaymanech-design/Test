import csv
import re
import gzip
import argparse

# =========================================================
# Extract structured data from .log or .gz log files
# =========================================================

parser = argparse.ArgumentParser(
    description="Extract structured data from log file (.log or .gz)"
)

parser.add_argument("logfile", help="Path to log file")
parser.add_argument(
    "-o",
    "--output",
    default="output.csv",
    help="Output CSV file"
)

args = parser.parse_args()

rows = []

# =========================================================
# PATTERNS
# =========================================================

patterns = [
    {
        "type": "DISABLE_DEMAND",
        "regex": re.compile(
            r"we start to disabled demand id\s+(\S+)\s+and uid\s+(\S+)",
            re.IGNORECASE
        ),
    },

    {
        "type": "USER_REMOVE",
        "regex": re.compile(
            r"user\s+(\S+)\s+will be remove\s+(\S+)",
            re.IGNORECASE
        ),
    },

    {
        "type": "USER_NOT_FOUND",
        "regex": re.compile(
            r"user\s+(\S+)\s+not found for demande\s+(\S+)",
            re.IGNORECASE
        ),
    },

    {
        "type": "ISSUE",
        "regex": re.compile(
            r"we have issue here for user demand\s+(\S+)\s+and user\s+(\S+)",
            re.IGNORECASE
        ),
    },

    {
        "type": "REMOVE_SERVICE",
        "regex": re.compile(
            r"We try to remove user\s+(\S+)\s+from service\s+(\S+)",
            re.IGNORECASE
        ),
    }
]

# =========================================================
# OPEN FILE (.gz OR NORMAL)
# =========================================================

if args.logfile.endswith(".gz"):
    file_handler = gzip.open(args.logfile, "rt", encoding="utf-8")
else:
    file_handler = open(args.logfile, "r", encoding="utf-8")

# =========================================================
# READ FILE
# =========================================================

with file_handler as file:

    for line in file:

        for item in patterns:

            match = item["regex"].search(line)

            if match:

                rows.append([
                    item["type"],
                    match.group(1),
                    match.group(2),
                    line.strip()
                ])

                break

# =========================================================
# WRITE CSV
# =========================================================

with open(args.output, "w", newline="", encoding="utf-8") as csvfile:

    writer = csv.writer(csvfile)

    writer.writerow([
        "Type",
        "Column1",
        "Column2",
        "Original_Log"
    ])

    writer.writerows(rows)

print(f"Extracted {len(rows)} records into {args.output}")
